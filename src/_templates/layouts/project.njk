{% include "includes/header.html" %}
{% include "includes/nav.html" %}
<main id="main">
  <article class="pm pm-project">
    <section class="pm-page-hero pm-page-hero--media">
      <div class="pm-hero-clip">
      <div class="pm-hero-media{% if heroVimeo %} pm-hero-media--video{% endif %}" aria-hidden="true">
        {% if heroVimeo %}
        <div class="pm-hero-video">
          <iframe title="" tabindex="-1" loading="eager"
            src="https://player.vimeo.com/video/{{ heroVimeo }}?background=1&amp;autoplay=1&amp;loop=1&amp;muted=1&amp;quality=1080p&amp;dnt=1"
            allow="autoplay; encrypted-media"></iframe>
        </div>
        {% elif video %}
        <video autoplay muted loop playsinline preload="metadata" poster="{{ image | projectImage }}">
          {% if video.webm %}<source src="{{ video.webm }}" type="video/webm" />{% endif %}
          {% if video.mp4 %}<source src="{{ video.mp4 }}" type="video/mp4" />{% endif %}
          {% if not video.webm and not video.mp4 %}<source src="{{ video }}" />{% endif %}
        </video>
        {% else %}
        <img src="{{ image | projectImage }}" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
        {% endif %}
      </div>
      </div>
      <div class="pm-wrap">
        <a class="pm-crumb" href="/case-studies/"><span aria-hidden="true">&larr;</span> All case studies</a>
        <p class="pm-eyebrow">{{ client }}{% if agency %} · {{ agency }}{% endif %}</p>
        <h1>{% for line in title.split("\n") %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</h1>
        {% if subtitle %}<p class="pm-lede">{{ subtitle }}</p>{% endif %}
        {% if metric %}<div class="pm-hero-metric"><strong>{{ metric }}</strong><span>{{ metricLabel }}</span></div>{% endif %}
        {% include "includes/details.html" %}
      </div>
    </section>

    <div class="pm-wrap pm-prose">
      {% if quote %}
      <figure class="pm-quote-block">
        <blockquote>“{{ quote }}”</blockquote>
        {% if author %}<cite>{% if citation %}<a href="{{ citation }}" target="_blank" rel="noopener">{{ author }}</a>{% else %}{{ author }}{% endif %}</cite>{% endif %}
      </figure>
      {% endif %}
      {{ content | safe }}
    </div>

    {# Show the next two case studies, wrapping around #}
    {% set all_projects = collections.animation %}
    {% set currentIndex = -1 %}
    {% for p in all_projects %}{% if p.url == page.url %}{% set currentIndex = loop.index0 %}{% endif %}{% endfor %}
    {% set next1 = all_projects[(currentIndex + 1) % all_projects.length] %}
    {% set next2 = all_projects[(currentIndex + 2) % all_projects.length] %}
    {% include "includes/explore-more.html" %}
  </article>
</main>
{% include "includes/footer.html" %}
