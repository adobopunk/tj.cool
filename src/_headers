# Security and caching headers (Netlify). Asset filenames aren't fingerprinted,
# so images and video get a week, not a year; fonts never change in place.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/app/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# The résumé PDFs stay downloadable but out of search results
/assets/*.pdf
  X-Robots-Tag: noindex, noarchive
